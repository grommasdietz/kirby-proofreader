{
  "name": "kirby-proofreader",
  "version": "1.11.1",
  "description": "Typographic suggestions for Kirby CMS",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && pnpm exec playwright install chromium",
    "update:dev": "pnpm update --dev",
    "dev": "kirbyup serve src/index.js",
    "build": "kirbyup src/index.js",
    "build:check": "node tools/check-generated-assets.mjs index.js index.css",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "pnpm run lint:fix",
    "docs:lint": "markdownlint -c .markdownlint.json 'docs/**/*.md' 'README.md' 'CONTRIBUTING.md' 'SECURITY.md' 'AGENTS.md' 'STYLE_GUIDE.md'",
    "docs:links": "node tools/check-docs.mjs",
    "docs:verify": "pnpm run docs:lint && pnpm run docs:links",
    "test:bundle": "node tools/verify-panel-bundle.mjs",
    "test:archive": "node tools/verify-release-archive.mjs",
    "test:hygiene": "node tools/check-repository-hygiene.mjs",
    "test:browser": "pnpm exec playwright test",
    "test:browser:debug": "PLAYWRIGHT_SERVER_LOGS=1 pnpm exec playwright test --reporter=list",
    "test:browser:report": "pnpm exec playwright show-report playwright-report",
    "verify": "pnpm run build:check && pnpm run lint && pnpm run test:bundle && pnpm run test:archive && pnpm run docs:verify && pnpm run test:hygiene && pnpm run test:browser",
    "verify:all": "composer validate --strict --no-check-version && composer check-platform-reqs && composer run verify && composer run release:check && pnpm run verify && git diff --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "kirbyup": "^3.4.1",
    "kirbyuse": "^1.3.1",
    "license-checker": "^25.0.1",
    "markdownlint-cli": "^0.47.0",
    "semantic-release": "^25.0.8",
    "typescript": "^5.9.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.14 <23",
    "pnpm": ">=11 <12"
  }
}
