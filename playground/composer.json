{
  "name": "grommasdietz/kirby-proofreader-playground",
  "description": "Integration playground for Kirby Proofreader",
  "license": "MIT",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../",
      "options": {
        "versions": {
          "grommasdietz/kirby-proofreader": "dev-main"
        }
      }
    }
  ],
  "require": {
    "php": "^8.3",
    "grommasdietz/kirby-proofreader": "dev-main",
    "grommasdietz/kirby-hidden-characters": "dev-kirby-6",
    "getkirby/cms": "^6.0@beta"
  },
  "require-dev": {
    "getkirby/cli": "^1.9"
  },
  "config": {
    "platform": {
      "php": "8.3.16"
    },
    "allow-plugins": {
      "getkirby/composer-installer": true,
      "php-http/discovery": true
    }
  }
}
